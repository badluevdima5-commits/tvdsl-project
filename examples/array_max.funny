// Array operations: finding maximum element
function arrayMax(arr: int[], n: int)
requires n > 0 and n <= length(arr)
returns maxVal: int
ensures forall(i: int | i >= 0 and i < n -> maxVal >= arr[i])
uses i: int
{
    maxVal = arr[0];
    i = 1;
    while (i < n)
    invariant i >= 1 and i <= n
    {
        if (arr[i] > maxVal)
            maxVal = arr[i];
        i = i + 1;
    }
}
